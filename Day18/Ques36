#include <stdio.h>

void productExceptSelf(int arr[], int n, int result[]) {
    int left[n], right[n];
    int i;

    // Initialize left and right arrays
    left[0] = 1;
    right[n-1] = 1;

    // Fill left array: product of elements to the left of i
    for(i = 1; i < n; i++) {
        left[i] = arr[i-1] * left[i-1];
    }

    // Fill right array: product of elements to the right of i
    for(i = n-2; i >= 0; i--) {
        right[i] = arr[i+1] * right[i+1];
    }

    // Result[i] = left[i] * right[i]
    for(i = 0; i < n; i++) {
        result[i] = left[i] * right[i];
    }
}

int main() {
    int n, i;
    int arr[100], result[100];

    // Input size of array
    printf("Enter number of elements: ");
    scanf("%d", &n);

    // Input array elements
    printf("Enter %d elements:\n", n);
    for(i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Compute product except self
    productExceptSelf(arr, n, result);

    // Output result array
    printf("Product of array except self:\n");
    for(i = 0; i < n; i++) {
        printf("%d ", result[i]);
    }
    printf("\n");

    return 0;
}
