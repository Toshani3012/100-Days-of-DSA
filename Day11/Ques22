#include <stdio.h>

int main() {
    int m, n;
    int mat[100][100], transpose[100][100];
    scanf("%d %d", &m, &n);

    // Read matrix
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &mat[i][j]);
        }
    }

    // Transpose
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            transpose[j][i] = mat[i][j];
        }
    }

    // Print transpose
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            printf("%d", transpose[i][j]);
            if (j < m - 1) printf(" ");
        }
        printf("\n");
    }

    return 0;
}
