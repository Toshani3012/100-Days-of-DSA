#include <stdio.h>
#include <ctype.h>  // for isalnum()
#define MAX 100

char stack[MAX];
int top = -1;

void push(char c) {
    stack[++top] = c;
}

char pop() {
    return stack[top--];
}

int precedence(char op) {
    if (op == '^') return 3;
    if (op == '*' || op == '/') return 2;
    if (op == '+' || op == '-') return 1;
    return 0;
}

void infixToPostfix(char* exp) {
    char *p = exp;
    while (*p != '\0') {
        if (isalnum(*p)) {
            // Operand → output directly
            printf("%c", *p);
        } else if (*p == '(') {
            push(*p);
        } else if (*p == ')') {
            while (top != -1 && stack[top] != '(') {
                printf("%c", pop());
            }
            pop(); // remove '('
        } else {
            // Operator
            while (top != -1 && precedence(stack[top]) >= precedence(*p)) {
                printf("%c", pop());
            }
            push(*p);
        }
        p++;
    }
    // Pop remaining operators
    while (top != -1) {
        printf("%c", pop());
    }
}

int main() {
    char exp[] = "A+(B*C-(D/E^F)*G)*H";
    printf("Infix: %s\n", exp);
    printf("Postfix: ");
    infixToPostfix(exp);
    return 0;
}
