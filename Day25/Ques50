#include <stdio.h>
#include <stdlib.h>

// Define the structure for a node
struct Node {
    int data;
    struct Node* next;
};

// Function to create a new node
struct Node* createNode(int value) {
    struct Node* newNode = (struct Node*)malloc(sizeof(struct Node));
    newNode->data = value;
    newNode->next = NULL;
    return newNode;
}

// Function to detect cycle and return starting node
struct Node* detectCycle(struct Node* head) {
    struct Node* slow = head;
    struct Node* fast = head;

    // Step 1: Detect if cycle exists
    while (fast != NULL && fast->next != NULL) {
        slow = slow->next;
        fast = fast->next->next;

        if (slow == fast) {
            // Step 2: Find cycle start
            slow = head;
            while (slow != fast) {
                slow = slow->next;
                fast = fast->next;
            }
            return slow; // cycle start node
        }
    }
    return NULL; // no cycle
}

int main() {
    // Create nodes
    struct Node* head = createNode(10);
    head->next = createNode(20);
    head->next->next = createNode(30);
    head->next->next->next = createNode(40);
    head->next->next->next->next = createNode(50);

    // Create a cycle: last node points to node with value 30
    head->next->next->next->next->next = head->next->next;

    struct Node* cycleStart = detectCycle(head);

    if (cycleStart != NULL)
        printf("Cycle starts at node with value: %d\n", cycleStart->data);
    else
        printf("No cycle in the linked list\n");

    return 0;
}
