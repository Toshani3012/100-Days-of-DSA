#include <stdio.h>
#include <stdlib.h>

// Define the structure for a node
struct Node {
    int data;
    struct Node* next;
};

// Function to create a new node
struct Node* createNode(int value) {
    struct Node* newNode = (struct Node*)malloc(sizeof(struct Node));
    newNode->data = value;
    newNode->next = NULL;
    return newNode;
}

// Function to print the linked list
void traverseList(struct Node* head) {
    struct Node* temp = head;
    while (temp != NULL) {
        printf("%d -> ", temp->data);
        temp = temp->next;
    }
    printf("NULL\n");
}

// Function to remove all occurrences of a key
struct Node* removeElements(struct Node* head, int key) {
    struct Node* temp = head;
    struct Node* prev = NULL;

    // Handle nodes at the beginning with the key
    while (temp != NULL && temp->data == key) {
        head = temp->next;
        free(temp);
        temp = head;
    }

    // Traverse the rest of the list
    while (temp != NULL) {
        if (temp->data == key) {
            prev->next = temp->next;
            free(temp);
            temp = prev->next;
        } else {
            prev = temp;
            temp = temp->next;
        }
    }

    return head;
}

int main() {
    // Create linked list: 10 -> 20 -> 30 -> 20 -> 40 -> 20
    struct Node* head = createNode(10);
    head->next = createNode(20);
    head->next->next = createNode(30);
    head->next->next->next = createNode(20);
    head->next->next->next->next = createNode(40);
    head->next->next->next->next->next = createNode(20);

    printf("Original List: ");
    traverseList(head);

    // Remove all occurrences of 20
    head = removeElements(head, 20);

    printf("After removing 20: ");
    traverseList(head);

    return 0;
}
