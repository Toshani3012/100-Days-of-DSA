#include <stdio.h>
#define MAX 100

int stack[MAX], minStack[MAX];
int top = -1, minTop = -1;

void push(int x) {
    if (top == MAX - 1) {
        printf("Stack Overflow!\n");
        return;
    }
    stack[++top] = x;
    if (minTop == -1 || x <= minStack[minTop]) {
        minStack[++minTop] = x;
    }
    printf("%d pushed\n", x);
}

void pop() {
    if (top == -1) {
        printf("Stack Underflow!\n");
        return;
    }
    int removed = stack[top--];
    if (removed == minStack[minTop]) {
        minTop--;
    }
    printf("%d popped\n", removed);
}

int getMin() {
    if (minTop == -1) {
        printf("Stack is empty!\n");
        return -1;
    }
    return minStack[minTop];
}

int main() {
    push(5);
    push(3);
    push(7);
    printf("Current Min: %d\n", getMin()); // 3
    pop();
    printf("Current Min: %d\n", getMin()); // 3
    pop();
    printf("Current Min: %d\n", getMin()); // 5
    return 0;
}
